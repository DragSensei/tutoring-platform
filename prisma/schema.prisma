datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TUTOR
  STUDENT
}

enum SessionType {
  PRIVATE // 500.00 EGP
  GROUP   // 375.00 EGP
}

enum SessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  ADMIN_DEPOSIT
  SESSION_DEDUCTION
  REFUND
}

model User {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String   @unique
  password_hash String
  role          Role     @default(STUDENT)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  wallet               Wallet?
  tutored_sessions     Session[]           @relation("TutorSessions")
  attendances          AttendanceRecord[]  @relation("StudentAttendances")
  created_transactions WalletTransaction[] @relation("AdminCreatedTransactions")

  @@index([role])
}

model Wallet {
  id                   String   @id @default(cuid())
  user_id              String   @unique
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  balance              Decimal  @default(0.00) @db.Decimal(10, 2)
  is_flagged_overdraft Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  transactions WalletTransaction[]

  @@index([user_id])
  @@index([is_flagged_overdraft])
}

model Session {
  id           String        @id @default(cuid())
  tutor_id     String
  tutor        User          @relation("TutorSessions", fields: [tutor_id], references: [id], onDelete: Restrict)
  title        String
  session_type SessionType
  start_time   DateTime
  end_time     DateTime
  deadline     DateTime // start_time + 4 hours
  token        String        @unique @default(uuid())
  status       SessionStatus @default(SCHEDULED)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  attendances  AttendanceRecord[]
  transactions WalletTransaction[]

  @@index([tutor_id])
  @@index([token])
  @@index([start_time])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  session_id  String
  session     Session  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  student_id  String
  student     User     @relation("StudentAttendances", fields: [student_id], references: [id], onDelete: Cascade)
  attended_at DateTime @default(now())

  @@unique([session_id, student_id])
  @@index([student_id])
  @@index([session_id])
}

model WalletTransaction {
  id                 String          @id @default(cuid())
  wallet_id          String
  wallet             Wallet          @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  amount             Decimal         @db.Decimal(10, 2) // positive for deposit/refund, negative for deduction
  transaction_type   TransactionType
  session_id         String?
  session            Session?        @relation(fields: [session_id], references: [id], onDelete: SetNull)
  created_by_user_id String?
  created_by         User?           @relation("AdminCreatedTransactions", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  created_at         DateTime        @default(now())

  @@index([wallet_id])
  @@index([session_id])
  @@index([created_at])
}
