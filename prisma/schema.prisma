datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TUTOR
  STUDENT
}

enum AccountStatus {
  PENDING_CREDENTIALS
  PENDING_PROFILE
  ACTIVE
}

enum AccountTokenPurpose {
  SETUP
  PASSWORD_RESET
}

enum SessionType {
  PRIVATE // 500.00 EGP
  GROUP // 375.00 EGP
}

enum SessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SessionSeriesStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum TransactionType {
  ADMIN_DEPOSIT
  SESSION_DEDUCTION
  REFUND
}

model User {
  id             String        @id @default(cuid())
  name           String?
  phone          String?       @unique
  email          String?       @unique
  password_hash  String?
  role           Role          @default(STUDENT)
  account_status AccountStatus @default(ACTIVE)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  wallet               Wallet?
  tutored_sessions     Session[]                  @relation("TutorSessions")
  tutored_series       SessionSeries[]            @relation("TutorSeries")
  attendances          AttendanceRecord[]         @relation("StudentAttendances")
  session_participants SessionParticipant[]
  series_participants  SessionSeriesParticipant[]
  setup_tokens         AccountSetupToken[]
  created_transactions WalletTransaction[]        @relation("AdminCreatedTransactions")

  @@index([role])
}

model Wallet {
  id                   String   @id @default(cuid())
  user_id              String   @unique
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  balance              Decimal  @default(0.00) @db.Decimal(10, 2)
  is_flagged_overdraft Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  transactions WalletTransaction[]

  @@index([user_id])
  @@index([is_flagged_overdraft])
}

model Session {
  id               String         @id @default(cuid())
  tutor_id         String
  tutor            User           @relation("TutorSessions", fields: [tutor_id], references: [id], onDelete: Restrict)
  series_id        String?
  series           SessionSeries? @relation(fields: [series_id], references: [id], onDelete: SetNull)
  occurrence_date  DateTime?
  series_exception Boolean        @default(false)
  title            String
  session_type     SessionType
  start_time       DateTime
  end_time         DateTime
  deadline         DateTime // legacy field name; attendance closes at end_time + policy grace
  token            String?        @unique // retained only for historical attendance-link data
  status           SessionStatus  @default(SCHEDULED)
  attendance_notes String?        @db.Text
  attendance_saved_at DateTime?
  attendance_finalized_at DateTime?
  series_exception_reason String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  attendances  AttendanceRecord[]
  participants SessionParticipant[]
  transactions WalletTransaction[]

  @@unique([series_id, occurrence_date])
  @@index([tutor_id])
  @@index([series_id, occurrence_date])
  @@index([token])
  @@index([start_time])
}

model SessionSeries {
  id               String              @id @default(cuid())
  tutor_id         String
  tutor            User                @relation("TutorSeries", fields: [tutor_id], references: [id], onDelete: Restrict)
  title            String
  session_type     SessionType
  weekday          Int
  start_minute     Int
  duration_minutes Int
  starts_on        DateTime
  ends_on          DateTime?
  status           SessionSeriesStatus @default(ACTIVE)
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  participants SessionSeriesParticipant[]
  occurrences  Session[]

  @@index([tutor_id, status])
  @@index([status, starts_on])
}

model SessionSeriesParticipant {
  series_id  String
  student_id String
  series     SessionSeries @relation(fields: [series_id], references: [id], onDelete: Cascade)
  student    User          @relation(fields: [student_id], references: [id], onDelete: Cascade)
  created_at DateTime      @default(now())

  @@id([series_id, student_id])
  @@index([student_id])
}

model SessionParticipant {
  session_id String
  student_id String
  session    Session  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [student_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@id([session_id, student_id])
  @@index([student_id])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  session_id  String
  session     Session  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  student_id  String
  student     User     @relation("StudentAttendances", fields: [student_id], references: [id], onDelete: Cascade)
  attended_at DateTime @default(now())

  @@unique([session_id, student_id])
  @@index([student_id])
  @@index([session_id])
}

model WalletTransaction {
  id                 String          @id @default(cuid())
  wallet_id          String
  wallet             Wallet          @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  amount             Decimal         @db.Decimal(10, 2) // positive for deposit/refund, negative for deduction
  transaction_type   TransactionType
  session_id         String?
  session            Session?        @relation(fields: [session_id], references: [id], onDelete: SetNull)
  created_by_user_id String?
  created_by         User?           @relation("AdminCreatedTransactions", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  created_at         DateTime        @default(now())

  @@index([wallet_id])
  @@index([session_id])
  @@index([created_at])
}

model PlatformPolicy {
  id                    String   @id @default("default")
  check_in_window_hours Int      @default(4)
  group_session_price   Decimal  @default(375.00) @db.Decimal(10, 2)
  private_session_price Decimal  @default(500.00) @db.Decimal(10, 2)
  allow_overdraft       Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

model AccountSetupToken {
  id          String    @id @default(cuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  purpose     AccountTokenPurpose @default(SETUP)
  token_hash  String    @unique
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  @@index([user_id, purpose, expires_at])
  @@index([expires_at, consumed_at])
}
