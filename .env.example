# Neon Serverless PostgreSQL Pooled & Direct Connection URLs
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/tutoring_db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/tutoring_db?sslmode=require"

# Auth / Session Secret (Min 32 characters)
AUTH_SECRET="super-secret-auth-key-change-this-in-production-min-32-chars"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret required by the scheduled attendance finalizer POST trigger
CRON_SECRET="replace-with-a-random-scheduler-secret"

# Node Environment
NODE_ENV="development"
